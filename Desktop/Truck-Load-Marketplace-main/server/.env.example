# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/trucklink

# Auth
JWT_SECRET=change-me-in-production

# Server
PORT=5000
CLIENT_URL=http://localhost:3000
CREDITS_PER_PACK=20

# PayNow Zimbabwe (3rd party integration)
# Keep the integration key server-side only - never commit it.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_CURRENCY=USD
PAYNOW_BASE_URL=https://www.paynow.co.zw
# Optional. Test integrations only accept the merchant's own registered email.
PAYNOW_AUTHEMAIL=
# Public URL PayNow can reach for callbacks (the deployed app, not localhost).
PAYNOW_PUBLIC_URL=http://localhost:3000

# Super admin bootstrap (node scripts/bootstrap-admin.js)
SUPERADMIN_EMAIL=superadmin@trucklink.test
SUPERADMIN_PASSWORD=Super@12345
SUPERADMIN_NAME=TruckLink Super Admin
